{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Documentos": {
    "DirectorioAlmacenamiento": "documentos-almacenados",
    "TamanioMaximoBytes": 10485760,
    "MargenSolicitudBytes": 1048576
  },
  "App": {
    "RedirigirHttps": true
  },
  "InicializacionBaseDatos": {
    "Habilitada": true,
    "IntentosMaximos": 12
  },
  "AdministradorInicial": {
    "Habilitado": false
  },
  "AllowedHosts": "*"
}
