# P4-02: copiar este archivo a .env antes de arrancar.
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# Los valores son ficticios y solo sirven para la demostración local.
# .env está ignorado por Git y excluido del contexto de construcción.

# Contraseña del administrador de SQL Server (sa). Debe cumplir la política
# de complejidad del motor y coincidir con la cadena de conexión generada.
SQLSERVER_SA_PASSWORD=Reservas_Local_2026!Demo

# Primer administrador (se crea solo si no existe ningún administrador).
# Para deshabilitarlo: ADMINISTRADOR_INICIAL_HABILITADO=false
ADMINISTRADOR_INICIAL_HABILITADO=true
ADMINISTRADOR_INICIAL_NOMBRE=Administrador Inicial
ADMINISTRADOR_INICIAL_CORREO=admin@reservas.local
ADMINISTRADOR_INICIAL_CONTRASENA=Admin_Local_2026!Demo

# Límites de documentos (bytes). El margen corresponde al sobrecoste del
# cuerpo multipart y debe ser mayor que cero.
DOCUMENTOS_TAMANIO_MAXIMO_BYTES=10485760
DOCUMENTOS_MARGEN_SOLICITUD_BYTES=1048576

# P4-03: clave de WeatherAPI.com para la evaluación climática. El marcador es
# ficticio; defina la clave real solo en su .env local y nunca la versione.
# Si se omite, la aplicación arranca y solo la evaluación climática responde
# de forma controlada (503).
WeatherApi__ApiKey=reemplace-con-su-clave-de-weatherapi
